---
import CollectionIndex from '../../components/CollectionIndex.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getProjects, projectListItem } from '../../lib/content';

const projects = [...(await getProjects())].sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
const items = projects.map((project) => projectListItem(project));
---

<BaseLayout title="Proyectos" description="Sistemas, campus virtuales e integraciones en los que trabajé.">
  <PageHeader
    eyebrow="Portafolio"
    title="Proyectos"
    description="Sistemas, campus virtuales e integraciones en los que trabajé."
  />
  <CollectionIndex
    items={items}
    tags={collectTags(projects)}
    base="/projects"
    noun={{ one: 'proyecto', many: 'proyectos' }}
    empty="No hay proyectos publicados."
  />
</BaseLayout>
