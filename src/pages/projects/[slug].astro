---
import { render } from 'astro:content';
import Neighbors from '../../components/Neighbors.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, neighbors, type Project } from '../../lib/content';
import { formatDate, isoDate, tagSlug } from '../../lib/format';
import { requireSite } from '../../lib/origin';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const projects = await getProjects();
const { newer, older } = neighbors(projects, project.id);
const { Content } = await render(project);
const description = project.data.summary || project.data.title;
const origin = requireSite(Astro.site);
const personId = new URL('/#ivan', origin).href;
const pageUrl = new URL(Astro.url.pathname, origin).href;
---

<BaseLayout
  title={project.data.title}
  description={description}
  image={project.data.image}
  imageAlt={project.data.image ? `Captura de ${project.data.title}` : undefined}
  imageWidth={project.data.imageWidth}
  imageHeight={project.data.imageHeight}
  ogType="article"
  extraGraph={[
    {
      '@type': 'CreativeWork',
      name: project.data.title,
      description,
      datePublished: project.data.date.toISOString(),
      url: pageUrl,
      author: { '@id': personId },
      ...(project.data.image ? { image: new URL(project.data.image, origin).href } : {}),
    },
  ]}
>
  <article class="mx-auto max-w-5xl px-5 py-12">
    <div class="max-w-3xl">
      <a href="/projects/" class="text-sm text-accent underline underline-offset-4">Volver a proyectos</a>
      <time class="mt-8 block font-mono text-xs tracking-wide text-muted uppercase" datetime={isoDate(project.data.date)}>
        {formatDate(project.data.date)}
      </time>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance">{project.data.title}</h1>
      {project.data.role && <p class="mt-3 text-accent">{project.data.role}</p>}
      {project.data.summary && <p class="mt-4 text-lg text-pretty text-muted">{project.data.summary}</p>}
      {
        project.data.outcome && (
          <p class="mt-4">
            <span class="font-medium">Resultado. </span>
            {project.data.outcome}
          </p>
        )
      }
      {
        project.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.data.tags.map((tag) => (
              <li>
                <a
                  href={`/projects/etiqueta/${tagSlug(tag)}/`}
                  class="rounded-full border border-line px-2 py-0.5 font-mono text-[11px] tracking-wide text-muted uppercase hover:text-ink"
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="mt-6 flex flex-wrap gap-3">
        {
          project.data.demoUrl && (
            <a
              href={project.data.demoUrl}
              class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-paper"
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver el proyecto
            </a>
          )
        }
        {
          project.data.repoUrl && (
            <a
              href={project.data.repoUrl}
              class="rounded-full border border-line px-4 py-2 text-sm font-medium"
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver el repositorio
            </a>
          )
        }
      </div>
      {
        project.data.image && (
          <img
            src={project.data.image}
            alt={`Captura de ${project.data.title}`}
            width={project.data.imageWidth}
            height={project.data.imageHeight}
            decoding="async"
            class="mt-8 w-full rounded-lg border border-line"
          />
        )
      }
      <div class="prose mt-8">
        <Content />
      </div>
      <Neighbors
        newer={newer ? { href: `/projects/${newer.id}/`, title: newer.data.title } : undefined}
        older={older ? { href: `/projects/${older.id}/`, title: older.data.title } : undefined}
      />
    </div>
  </article>
</BaseLayout>
