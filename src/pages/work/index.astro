---
import { render } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';
import Period from '../../components/Period.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getJobs } from '../../lib/content';

const jobs = await getJobs();
const rendered = await Promise.all(
  jobs.map(async (job) => {
    const { Content } = await render(job);
    return { job, Content };
  }),
);
---

<BaseLayout
  title="Trayectoria"
  description="Línea de tiempo de Ivan Garcia Vega: arquitectura de integraciones, plataformas LMS e infraestructura."
>
  <PageHeader
    eyebrow="Trabajo"
    title="Trayectoria"
    description="Del rol más reciente al más antiguo. Cada puesto queda en la línea de tiempo con su periodo, la organización y el sistema sobre el que trabajé."
  />
  <div class="mx-auto max-w-5xl px-5 py-12">
    {
      rendered.length === 0 ? (
        <p class="text-muted">No hay puestos publicados.</p>
      ) : (
        <ol class="space-y-10">
      {
        rendered.map(({ job, Content }) => (
          <li class="relative border-l border-line pl-6">
            <span class="absolute top-2 left-0 size-2 -translate-x-1/2 rounded-full bg-accent" aria-hidden="true" />
            <Period start={job.data.startDate} end={job.data.endDate} />
            <h2 class="mt-2 text-2xl font-semibold tracking-tight">{job.data.title}</h2>
            <p class="text-accent">{job.data.company}</p>
            {job.data.tags.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2">
                {job.data.tags.map((tag) => (
                  <li class="rounded-full border border-line px-2 py-0.5 font-mono text-[11px] tracking-wide text-muted uppercase">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
            <div class="prose mt-4 max-w-3xl">
              <Content />
            </div>
          </li>
        ))
      }
        </ol>
      )
    }
  </div>
</BaseLayout>
