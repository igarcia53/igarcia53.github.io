---
import { render } from 'astro:content';
import LessonProgress from '../../components/LessonProgress.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCourses, getLessons, groupLessons, lessonPath, type Course } from '../../lib/content';
import { kindLabel, levelLabel, tagSlug } from '../../lib/format';
import { requireSite } from '../../lib/origin';

export async function getStaticPaths() {
  const courses = await getCourses();
  return courses.map((course) => ({
    params: { course: course.id },
    props: { course },
  }));
}

interface Props {
  course: Course;
}

const { course } = Astro.props;
const lessons = await getLessons(course.id);
const modules = groupLessons(course, lessons);
const moduleGroups = modules.map((group, index) => {
  const baseId = `modulo-${tagSlug(group.module) || 'modulo'}`;
  const duplicated =
    modules.filter((item) => tagSlug(item.module) === tagSlug(group.module)).length > 1;
  return {
    ...group,
    headingId: duplicated ? `${baseId}-${index + 1}` : baseId,
  };
});
const { Content } = await render(course);
const description = course.data.summary || course.data.title;
const origin = requireSite(Astro.site);
const personId = new URL('/#ivan', origin).href;
---

<BaseLayout
  title={course.data.title}
  description={description}
  extraGraph={[
    {
      '@type': 'Course',
      name: course.data.title,
      description,
      url: new URL(Astro.url.pathname, origin).href,
      inLanguage: 'es',
      provider: { '@id': personId },
      teaches: course.data.tags,
    },
  ]}
>
  <article class="mx-auto max-w-5xl px-5 py-12">
    <a href="/learn/" class="text-sm text-accent underline underline-offset-4">Volver a EdTech</a>
    <p class="mt-8 font-mono text-xs tracking-wide text-muted uppercase">
      {levelLabel[course.data.level]}
      {course.data.duration ? ` · ${course.data.duration}` : ''}
    </p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-balance">{course.data.title}</h1>
    {course.data.summary && <p class="mt-4 max-w-3xl text-lg text-pretty text-muted">{course.data.summary}</p>}
    <div class="mt-6">
      <LessonProgress lessonIds={lessons.map((lesson) => lesson.id)} />
    </div>
    <div class="prose mt-8 max-w-3xl">
      <Content />
    </div>
    {
      moduleGroups.length === 0 ? (
        <p class="mt-12 max-w-3xl text-muted">Este curso todavía no tiene lecciones publicadas.</p>
      ) : (
        <div class="mt-12 max-w-3xl space-y-10">
      {
        moduleGroups.map((group) => (
          <section aria-labelledby={group.headingId}>
            <h2 id={group.headingId} class="text-2xl font-semibold tracking-tight">
              {group.module}
            </h2>
            <ol class="mt-4 divide-y divide-line border-y border-line">
              {group.lessons.map((lesson) => (
                <li>
                  <a href={lessonPath(lesson)} class="flex items-start justify-between gap-4 py-4 hover:text-accent">
                    <span>
                      <span class="font-mono text-xs tracking-wide text-muted uppercase">
                        {kindLabel[lesson.data.kind]}
                        {lesson.data.duration ? ` · ${lesson.data.duration}` : ''}
                      </span>
                      <span class="mt-1 block font-semibold">{lesson.data.title}</span>
                      {lesson.data.summary && <span class="mt-1 block text-sm text-muted">{lesson.data.summary}</span>}
                    </span>
                    <span class="shrink-0 font-mono text-xs text-muted" data-lesson-status={lesson.id}>
                      Pendiente
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
        </div>
      )
    }
  </article>
</BaseLayout>
