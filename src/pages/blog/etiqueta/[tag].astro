---
import CollectionIndex from '../../../components/CollectionIndex.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { collectTags, filterByTag, getPosts } from '../../../lib/content';
import { tagSlug } from '../../../lib/format';

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTags(posts).map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const posts = filterByTag(await getPosts(), tagSlug(tag));
const items = posts.map((post) => ({
  href: `/blog/${post.id}/`,
  title: post.data.title,
  summary: post.data.summary,
  date: post.data.date,
  tags: post.data.tags,
}));
---

<BaseLayout title={`Blog: ${tag}`} description={`Publicaciones etiquetadas con ${tag}.`}>
  <PageHeader eyebrow="Notas" title={tag} description={`Publicaciones etiquetadas con ${tag}.`} />
  <CollectionIndex
    items={items}
    tags={collectTags(await getPosts())}
    base="/blog"
    activeTag={tagSlug(tag)}
    noun={{ one: 'publicación', many: 'publicaciones' }}
    empty="No hay publicaciones con esta etiqueta."
  />
</BaseLayout>
