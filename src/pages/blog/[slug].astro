---
import { render } from 'astro:content';
import Neighbors from '../../components/Neighbors.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, neighbors, type Post } from '../../lib/content';
import { formatDate, isoDate, tagSlug } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const posts = await getPosts();
const { newer, older } = neighbors(posts, post.id);
const { Content } = await render(post);
const description = post.data.summary || post.data.title;
---

<BaseLayout
  title={post.data.title}
  description={description}
  ogType="article"
  article={{
    headline: post.data.title,
    description,
    datePublished: post.data.date,
  }}
>
  <article class="mx-auto max-w-5xl px-5 py-12">
    <div class="max-w-3xl">
      <a href="/blog/" class="text-sm text-accent underline underline-offset-4">Volver al blog</a>
      <time class="mt-8 block font-mono text-xs tracking-wide text-muted uppercase" datetime={isoDate(post.data.date)}>
        {formatDate(post.data.date)}
      </time>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance">{post.data.title}</h1>
      {post.data.summary && <p class="mt-4 text-lg text-pretty text-muted">{post.data.summary}</p>}
      {
        post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li>
                <a
                  href={`/blog/etiqueta/${tagSlug(tag)}/`}
                  class="rounded-full border border-line px-2 py-0.5 font-mono text-[11px] tracking-wide text-muted uppercase hover:text-ink"
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="prose mt-8">
        <Content />
      </div>
      <Neighbors
        newer={newer ? { href: `/blog/${newer.id}/`, title: newer.data.title } : undefined}
        older={older ? { href: `/blog/${older.id}/`, title: older.data.title } : undefined}
      />
    </div>
  </article>
</BaseLayout>
