---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { knowsAbout, site } from '../data/site';
import { paper } from '../scripts/theme';

interface ArticleMeta {
  headline: string;
  description: string;
  datePublished: Date;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: 'website' | 'article';
  robots?: string;
  article?: ArticleMeta;
  extraGraph?: Record<string, unknown>[];
}

const {
  title = site.name,
  description = site.description,
  image = site.ogImage,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  ogType = 'website',
  robots = 'index, follow',
  article,
  extraGraph = [],
} = Astro.props;

const origin = Astro.site;
const configuredSite = origin?.href.replace(/\/$/, '');
if (!origin || configuredSite !== site.url) {
  throw new Error(
    `La URL de astro.config (${configuredSite ?? 'sin definir'}) no coincide con site.url (${site.url}).`,
  );
}

const canonical = new URL(Astro.url.pathname, origin);
const imageUrl = new URL(image, origin);
const fullTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const resolvedAlt = imageAlt ?? (image === site.ogImage ? site.ogImageAlt : description);
const personId = new URL('/#ivan', origin).href;
const rssUrl = new URL('/rss.xml', origin);
const themeInit = `(function(){var light=${JSON.stringify(paper.light)};var dark=${JSON.stringify(paper.dark)};var theme="light";try{var stored=localStorage.getItem("theme");if(stored==="light"||stored==="dark")theme=stored;else if(window.matchMedia("(prefers-color-scheme: dark)").matches)theme="dark";}catch(e){if(window.matchMedia("(prefers-color-scheme: dark)").matches)theme="dark";}var root=document.documentElement;root.classList.toggle("dark",theme==="dark");root.classList.toggle("light",theme==="light");root.style.colorScheme=theme;root.style.backgroundColor=theme==="dark"?dark:light;var meta=document.querySelector('meta[name="theme-color"]');if(meta)meta.setAttribute("content",theme==="dark"?dark:light);})();`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    description: site.description,
    inLanguage: site.locale,
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: site.name,
    jobTitle: site.role,
    description: site.description,
    url: site.url,
    email: site.email,
    sameAs: [site.linkedin, site.twitter],
    knowsAbout: [...knowsAbout],
  },
];

if (article) {
  graph.push({
    '@type': 'BlogPosting',
    headline: article.headline,
    description: article.description,
    datePublished: article.datePublished.toISOString(),
    author: { '@id': personId },
    image: imageUrl.href,
    mainEntityOfPage: canonical.href,
    inLanguage: site.locale,
  });
}

graph.push(...extraGraph);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': graph,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f0e8" />
    <script is:inline set:html={themeInit}></script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`Blog de ${site.name}`} href={rssUrl.href} />
    <meta property="og:type" content={article ? 'article' : ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:alt" content={resolvedAlt} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitterHandle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content={resolvedAlt} />
    {
      article && (
        <meta property="article:published_time" content={article.datePublished.toISOString()} />
      )
    }
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
