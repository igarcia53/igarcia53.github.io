---
import { nav } from '../data/site';

const pathname = Astro.url.pathname;

function normalize(path: string): string {
  if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
  return path;
}

function isCurrent(href: string): boolean {
  const current = normalize(pathname);
  const target = normalize(href);
  if (target === '/') return current === '/';
  return current === target || current.startsWith(`${target}/`);
}
---

<header class="sticky top-0 z-50 border-b border-line bg-paper">
  <div class="mx-auto flex h-16 max-w-5xl items-center gap-3 px-5">
    <a href="/" class="flex min-w-0 items-center gap-2 font-semibold tracking-tight">
      <span
        class="grid size-8 shrink-0 place-items-center rounded-md bg-accent font-mono text-xs text-accent-contrast"
        aria-hidden="true"
      >
        IG
      </span>
      <span class="truncate">Ivan Garcia Vega</span>
    </a>
    <nav class="ms-6 hidden items-center gap-1 md:flex" aria-label="Secciones">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3 py-2 text-sm',
              isCurrent(item.href) ? 'bg-ink text-paper' : 'text-muted hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="ms-auto flex items-center gap-1">
      <button
        type="button"
        data-theme-toggle
        class="inline-flex size-11 items-center justify-center rounded-full border border-line"
        aria-pressed="false"
        aria-label="Usar tema oscuro"
      >
        <svg class="icon-sun size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
        </svg>
      </button>
      <button
        id="site-menu-button"
        type="button"
        class="menu-button inline-flex size-11 items-center justify-center rounded-full border border-line md:hidden"
        aria-expanded="false"
        aria-controls="site-drawer"
        aria-label="Abrir menú"
      >
        <svg class="icon-open size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>
  <div
    id="site-drawer"
    class="fixed inset-x-0 bottom-0 top-16 z-40 bg-paper"
    role="dialog"
    aria-modal="true"
    aria-labelledby="site-menu-title"
    hidden
  >
    <nav class="mx-auto flex max-w-5xl flex-col gap-2 px-5 py-8" aria-label="Secciones">
      <div class="flex items-center justify-between">
        <p id="site-menu-title" class="font-mono text-xs tracking-widest text-muted uppercase">Menú</p>
        <button type="button" data-close-drawer class="rounded-full border border-line px-3 py-2 text-sm">
          Cerrar
        </button>
      </div>
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-3 text-lg',
              isCurrent(item.href) ? 'bg-ink text-paper' : 'text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
<script>
  import '../scripts/shell.ts';
</script>
