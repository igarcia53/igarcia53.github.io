---
interface Props {
  href: string;
  title: string;
  summary?: string;
  meta: string;
  tags?: string[];
}

const { href, title, summary, meta, tags = [] } = Astro.props;
---

<li>
  <a href={href} class="block rounded-lg border border-line px-4 py-4 hover:border-accent">
    <p class="font-mono text-xs tracking-wide text-muted uppercase">{meta}</p>
    <h3 class="mt-2 text-lg font-semibold tracking-tight">{title}</h3>
    {summary && <p class="mt-2 text-sm text-pretty text-muted">{summary}</p>}
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full border border-line px-2 py-0.5 font-mono text-[11px] tracking-wide text-muted uppercase">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </a>
</li>
